# backend/.env.example
DATABASE_URL=sqlite+aiosqlite:///./safewatch.db
JWT_SECRET_KEY=            # required in production, 32+ random bytes: openssl rand -hex 32
JWT_TTL_MINUTES=1440
ALLOWED_ORIGINS=https://your-frontend-domain.com
ENV=development             # set to "production" to enable strict startup checks
SQL_ECHO=false
WEB_CONCURRENCY=4